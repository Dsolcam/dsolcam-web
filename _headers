# Cloudflare Pages — reglas de encabezados HTTP
# Nota sobre la Content-Security-Policy (CSP):
# - script-src no incluye 'unsafe-inline' ni 'unsafe-eval': todo el JavaScript
#   vive en js/main.js y js/translations.js. Los bloques <script type="application/ld+json">
#   son datos inertes, no ejecutan código y no requieren 'unsafe-inline'.
# - style-src sí incluye 'unsafe-inline' porque el sitio usa algunos estilos en línea
#   puntuales (por ejemplo, colores de texto sobre fondo oscuro en la sección de
#   TerraPiezas). Es la única concesión deliberada a 'unsafe-inline' en este proyecto.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
  Cache-Control: public, max-age=3600

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.avif
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=3600

/app-ads.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
